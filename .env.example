# Canvas LMS MCP Server – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to source control.

# Your Canvas instance URL (no trailing slash)
CANVAS_BASE_URL=https://yourschool.instructure.com

# Canvas API access token
# Generate one in Canvas: Account → Settings → New Access Token
CANVAS_API_TOKEN=your_canvas_api_token_here

# Optional JSON token map for multi-token deployments.
# Keys can be course ids, account:<id>, or default.
CANVAS_API_TOKENS=

# Optional production safety controls
# Set true/1/yes to block all Canvas write tools.
CANVAS_READ_ONLY=false

# Comma-separated Canvas course ids this server may access.
# Leave blank to allow any course visible to the configured token.
CANVAS_ALLOWED_COURSE_IDS=

# Comma-separated Canvas account ids this server may access.
CANVAS_ALLOWED_ACCOUNT_IDS=

# Set true/1/yes to require confirm=true or confirmation=CONFIRM on live write calls.
CANVAS_REQUIRE_CONFIRMATION=false

# Set true/1/yes to validate write calls without mutating Canvas.
CANVAS_DRY_RUN=false

# Structured stderr audit logging for MCP tool calls.
# Set to false only if your MCP host captures equivalent audit events.
CANVAS_MCP_AUDIT_LOG=true
